<footer style="padding:34px clamp(24px,6vw,110px);display:flex;justify-content:space-between;align-items:center;gap:20px;flex-wrap:wrap;font-size:12px;letter-spacing:.14em;color:#6d675f">
  <span>© {MARCA} · sites para fotógrafos</span>
  <a href="https://engenheiroparanhos.com.br" target="_blank" rel="noopener noreferrer" style="border-bottom:1px solid #c9c3ba;padding-bottom:3px">quem faz · engenheiroparanhos.com.br</a>
</footer>

<script>
  // Empacotado pelo Astro num arquivo próprio (nada de script inline), para a
  // página rodar sob Content-Security-Policy com script-src 'self'.

  /** Busca por id e falha alto se o elemento sumiu do HTML. */
  function pega<T extends HTMLElement>(id: string): T {
    const el = document.getElementById(id);
    if (!el) throw new Error(`Elemento #${id} não encontrado`);
    return el as T;
  }

  // ---- Demo interativa (seção 02) ----
  (function () {
    const nomeI = pega<HTMLInputElement>("dm-nome");
    const valorI = pega<HTMLInputElement>("dm-valor");
    const btn = pega<HTMLButtonElement>("dm-salvar");
    const siteNome = pega("site-nome");
    const siteValor = pega("site-valor");
    const card = pega("site-card");
    const salvando = pega("site-salvando");
    const publicado = pega("site-publicado");
    const dmPub = pega("dm-publicado");

    let tSalvar: ReturnType<typeof setTimeout> | undefined;
    let tRealce: ReturnType<typeof setTimeout> | undefined;
    let ocupado = false;

    function salvar() {
      if (ocupado) return;
      ocupado = true;
      btn.textContent = "salvando…";
      salvando.style.display = "inline";
      publicado.style.display = "none";
      dmPub.style.display = "none";
      clearTimeout(tSalvar);
      clearTimeout(tRealce);

      tSalvar = setTimeout(function () {
        ocupado = false;
        btn.textContent = "Salvar alterações";
        salvando.style.display = "none";

        // textContent (nunca innerHTML): o que a pessoa digita entra como
        // texto, não como marcação.
        siteNome.textContent = nomeI.value.trim() || "Seu pacote";
        const valor = (valorI.value || "0").replace(/[^\d.,]/g, "") || "0";
        siteValor.textContent = "R$ " + valor;

        publicado.style.display = "block";
        dmPub.style.display = "inline";
        card.style.borderColor = "#c9b48d";
        card.style.background = "rgba(138,111,74,.28)";
        card.style.transform = "scale(1.025)";
        siteValor.style.color = "#e8cf9e";

        tRealce = setTimeout(function () {
          card.style.borderColor = "rgba(255,255,255,.22)";
          card.style.background = "transparent";
          card.style.transform = "scale(1)";
          siteValor.style.color = "#fff";
        }, 1600);
      }, 750);
    }

    btn.addEventListener("click", salvar);
    const aoTeclar = (e: KeyboardEvent) => {
      if (e.key === "Enter") {
        e.preventDefault();
        salvar();
      }
    };
    nomeI.addEventListener("keydown", aoTeclar);
    valorI.addEventListener("keydown", aoTeclar);
  })();

  // ---- Vitrine: abas da janela (seção 05) ----
  (function () {
    const frame = pega<HTMLIFrameElement>("janela-frame");
    const urlEl = pega("janela-url");
    const legEl = pega("janela-legenda");
    const novaAba = pega<HTMLAnchorElement>("janela-nova-aba");

    const abas = {
      site: {
        btn: pega<HTMLButtonElement>("btn-site"),
        src: "/demos/site/index.html",
        url: "estudionome.com.br",
        leg: "role dentro da janela · o site é este, de verdade",
      },
      proposta: {
        btn: pega<HTMLButtonElement>("btn-proposta"),
        src: "/demos/proposta.html",
        url: "seuestudio.com.br/proposta/familia",
        leg: "role dentro da janela · é assim que a sua cliente vê a proposta",
      },
      painel: {
        btn: pega<HTMLButtonElement>("btn-painel"),
        src: "/demos/painel.html",
        url: "seuestudio.com.br/admin",
        leg: "role dentro da janela · é assim que você edita tudo sozinha",
      },
    } as const;

    type Aba = keyof typeof abas;
    const nomes = Object.keys(abas) as Aba[];

    function pintar(escolhida: Aba) {
      for (const nome of nomes) {
        const ligada = nome === escolhida;
        const b = abas[nome].btn;
        b.style.background = ligada ? "#e9e6e1" : "transparent";
        b.style.color = ligada ? "#14110f" : "rgba(255,255,255,.75)";
        b.style.border = "1px solid " + (ligada ? "#e9e6e1" : "rgba(255,255,255,.3)");
        b.setAttribute("aria-selected", ligada ? "true" : "false");
      }
      const d = abas[escolhida];
      if (frame.getAttribute("src") !== d.src) frame.setAttribute("src", d.src);
      urlEl.textContent = d.url;
      legEl.textContent = d.leg;
      // visibility:hidden continua focável pelo teclado; hidden remove de vez
      novaAba.hidden = escolhida !== "site";
    }

    for (const nome of nomes) {
      abas[nome].btn.addEventListener("click", () => pintar(nome));
    }
    // Setas navegam entre as abas, como manda o padrão de tablist
    for (const nome of nomes) {
      abas[nome].btn.addEventListener("keydown", (e: KeyboardEvent) => {
        if (e.key !== "ArrowRight" && e.key !== "ArrowLeft") return;
        e.preventDefault();
        const i = nomes.indexOf(nome);
        const passo = e.key === "ArrowRight" ? 1 : -1;
        const alvo = nomes[(i + passo + nomes.length) % nomes.length]!;
        pintar(alvo);
        abas[alvo].btn.focus();
      });
    }

    pintar("site");
  })();

  // ---- Instagram: feed que se atualiza sozinho (seção 04) ----
  (function () {
    const grid = pega("ig-grid");

    const fotos = [
      "/assets/ph-l-01.svg", "/assets/ph-l-02.svg", "/assets/ph-l-03.svg", "/assets/ph-l-04.svg",
      "/assets/ph-hero-01.svg", "/assets/ph-hero-02.svg", "/assets/ph-hero-03.svg",
      "/assets/ph-hero-05.svg", "/assets/ph-hero-06.svg", "/assets/ph-p-04.svg", "/assets/ph-p-05.svg",
    ];
    const QUADROS = 9;
    const INTERVALO = 3200;
    const REALCE = 1200;

    // Os nove quadros são criados uma vez e depois só têm o src trocado.
    // Recriar o HTML a cada volta piscaria e recarregaria as imagens.
    const quadros = Array.from({ length: QUADROS }, () => {
      const raiz = document.createElement("span");
      raiz.className = "ig-tile";
      raiz.style.cssText = "position:relative;display:block;aspect-ratio:1;overflow:hidden";

      const img = document.createElement("img");
      img.alt = "";
      img.loading = "lazy";
      img.decoding = "async";
      img.style.cssText = "width:100%;height:100%;object-fit:cover;display:block";

      const tarja = document.createElement("span");
      tarja.className = "ig-ov";
      tarja.textContent = "ver no instagram";
      tarja.style.cssText =
        "position:absolute;inset:0;background:rgba(20,17,15,.5);display:flex;align-items:flex-end;" +
        "padding:9px;font-size:7.5px;letter-spacing:.18em;text-transform:uppercase;color:#fff";

      const etiqueta = document.createElement("span");
      etiqueta.textContent = "novo post";
      etiqueta.hidden = true;
      etiqueta.style.cssText =
        "position:absolute;top:6px;left:6px;background:#8a6f4a;color:#fff;font-size:7px;" +
        "letter-spacing:.16em;text-transform:uppercase;padding:3px 7px";

      raiz.append(img, tarja, etiqueta);
      return { raiz, img, etiqueta };
    });
    grid.append(...quadros.map((q) => q.raiz));

    let topo = 0;
    function pintarFeed(realcar: boolean) {
      quadros.forEach((q, k) => {
        q.img.src = fotos[(topo + k) % fotos.length]!;
        const novo = realcar && k === 0;
        q.raiz.style.boxShadow = novo ? "0 0 0 3px #8a6f4a inset" : "0 0 0 0 rgba(0,0,0,0) inset";
        q.etiqueta.hidden = !novo;
      });
    }
    pintarFeed(false);

    let giro: ReturnType<typeof setInterval> | undefined;
    let tRealce: ReturnType<typeof setTimeout> | undefined;
    const semMovimento = window.matchMedia("(prefers-reduced-motion: reduce)");

    function parar() {
      clearInterval(giro);
      clearTimeout(tRealce);
      giro = undefined;
    }
    function girar() {
      // WCAG 2.2.2: nada se move sozinho para quem pediu menos movimento
      if (giro || semMovimento.matches) return;
      giro = setInterval(function () {
        topo = (topo + 1) % fotos.length;
        pintarFeed(true);
        tRealce = setTimeout(() => pintarFeed(false), REALCE);
      }, INTERVALO);
    }

    // Só gira enquanto a seção está na tela: não adianta gastar bateria
    // animando um bloco que ficou dez telas acima.
    new IntersectionObserver(
      (entradas) => entradas.forEach((e) => (e.isIntersecting ? girar() : parar())),
      { threshold: 0.15 },
    ).observe(grid);

    semMovimento.addEventListener("change", function () {
      parar();
      pintarFeed(false);
      girar();
    });
  })();
</script>
</body>
</html>
