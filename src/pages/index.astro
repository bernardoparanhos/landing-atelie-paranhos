---
import { Image } from "astro:assets";
import heroGestante from "../assets/hero-gestante.jpg";
import heroNewborn from "../assets/hero-newborn.jpg";

// Tudo o que se edita para publicar mora em src/config.ts.
import { MARCA, TITULO, DESCRICAO, base, canonical, waLink } from "../config";

const rotas = ["gestante", "recem-nascido", "familia", "smash", "sobre", "proposta"];

// Content-Security-Policy como <meta>: vale mesmo quando a hospedagem não
// aplica cabeçalhos (ex.: GitHub Pages, abrir o dist/ direto). Os cabeçalhos em
// public/_headers e vercel.json são a camada principal e trazem também
// frame-ancestors, que <meta> não consegue expressar. Ver docs/SEGURANCA.md.
// Fora de produção fica desligada para não brigar com o dev toolbar do Astro.
const csp = [
  "default-src 'self'",
  "base-uri 'none'",
  "object-src 'none'",
  "form-action 'none'",
  "script-src 'self'",
  // 'unsafe-inline' em estilo é inevitável: a página inteira usa style="" nos
  // elementos. Não abre caminho para execução de script.
  "style-src 'self' 'unsafe-inline'",
  "img-src 'self' data:",
  "font-src 'self'",
  "connect-src 'self'",
  "frame-src 'self'",
  "upgrade-insecure-requests",
].join("; ");
---

<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{TITULO}</title>
<meta name="description" content={DESCRICAO} />
<meta name="color-scheme" content="light" />
<meta name="theme-color" content="#e9e6e1" />
<meta name="author" content={MARCA} />
<meta name="robots" content="index, follow, max-image-preview:large" />
{import.meta.env.PROD && <meta http-equiv="Content-Security-Policy" content={csp} />}
{canonical && <link rel="canonical" href={canonical} />}

<!-- O SVG atende todo navegador moderno (e troca de cor em aba escura).
     Os PNG são para navegador antigo e para o iOS; cada tamanho tem a
     espessura de traço própria — ver docs/MANUTENCAO.md. -->
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
<link rel="icon" href="/favicon-16.png" sizes="16x16" type="image/png" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />

<meta property="og:type" content="website" />
<meta property="og:locale" content="pt_BR" />
<meta property="og:site_name" content={MARCA} />
<meta property="og:title" content={TITULO} />
<meta property="og:description" content={DESCRICAO} />
{canonical && <meta property="og:url" content={canonical} />}
{base && <meta property="og:image" content={`${base}${heroGestante.src}`} />}
{base && <meta property="og:image:alt" content="Exemplo de proposta de ensaio publicada como página própria" />}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={TITULO} />
<meta name="twitter:description" content={DESCRICAO} />
{base && <meta name="twitter:image" content={`${base}${heroGestante.src}`} />}

<link rel="preload" href="/fonts/jost-normal-latin.woff2" as="font" type="font/woff2" crossorigin />
<link rel="preload" href="/fonts/cormorant-garamond-normal-latin.woff2" as="font" type="font/woff2" crossorigin />
<link rel="stylesheet" href="/fonts/fontes.css" />
<style>
  *{box-sizing:border-box}
  body{margin:0;background:#e9e6e1;color:#14110f;font-family:'Jost',system-ui,sans-serif}
  a{color:inherit;text-decoration:none}
  a:hover{color:#8a6f4a}
  img{display:block}
  @keyframes pulso{0%,100%{opacity:1}50%{opacity:.45}}
  .ig{transition:background .3s}
  .ig:hover{background:linear-gradient(45deg,#f9ce34,#ee2a7b,#6228d7)}
  .btn-wa{transition:background .3s}
  .btn-wa:hover{background:#8a6f4a;color:#fff}
  .tabbtn{transition:background .3s,color .3s}
  .janela-frame{scrollbar-width:none;-ms-overflow-style:none}
  .janela-frame::-webkit-scrollbar{width:0;height:0;display:none}

  /* Feed do Instagram (seção 04): a tarja "ver no instagram" ao passar o mouse.
     Precisa de :global() porque estes quadros são criados por JavaScript — o
     Astro escopa o <style> por atributo e só marca o que está no template, então
     uma regra normal não alcançaria elementos criados em tempo de execução. */
  :global(.ig-tile){transition:box-shadow .5s}
  :global(.ig-tile .ig-ov){opacity:0;transition:opacity .3s}
  :global(.ig-tile:hover .ig-ov){opacity:1}

  /* ===================== ACESSIBILIDADE =====================
     Foco visível em qualquer fundo: sem isso, quem navega por teclado se
     perde nas seções escuras (04) e nos botões sobre fundo claro. */
  :where(a, button, input, [tabindex]):focus-visible{
    outline:2px solid #8a6f4a;
    outline-offset:3px;
    border-radius:2px;
  }
  /* Nas faixas escuras o ouro tem pouco contraste: usa o papel */
  section[style*="background:#14110f"] :where(a, button):focus-visible{
    outline-color:#e9e6e1;
  }

  /* Respeita quem pediu menos movimento no sistema (WCAG 2.3.3).
     A seta "↓ mude o valor aqui embaixo" pisca em laço infinito. */
  @media (prefers-reduced-motion: reduce){
    *,*::before,*::after{
      animation-duration:.001ms !important;
      animation-iteration-count:1 !important;
      transition-duration:.001ms !important;
      scroll-behavior:auto !important;
    }
  }

  /* ===================== RESPONSIVO =====================
     A página é construída com estilos inline (veio do Claude Design),
     por isso os ajustes de tela aqui precisam de !important para vencer
     o inline. Cada bloco está comentado com o que ele conserta. */

  /* trava geral: nada escapa pelas laterais em nenhuma largura */
  html{-webkit-text-size-adjust:100%}
  body{overflow-x:clip}
  img,svg,video,iframe{max-width:100%}
  input,button,textarea,select{max-width:100%;font-family:inherit}
  h1,h2,h3,p,li,span,a{overflow-wrap:break-word}

  /* o texto longo do hero e dos títulos nunca fura a coluna */
  .aba-nova-curto{display:none}

  /* --- até 900px: hero e demo interativa empilham (2 colunas ficariam
         estreitas demais para a colagem e para o formulário do painel) --- */
  @media (max-width:900px){
    .hero-grid,.demo-grid{grid-template-columns:1fr !important}
  }

  /* --- até 860px: a colagem do hero deixa de ser absoluta e passa a
         empilhar, senão o cartão de baixo era cortado pelo overflow --- */
  @media (max-width:860px){
    .hero-colagem{min-height:0 !important}
    .hero-card-a{position:static !important;width:100% !important;max-width:360px;margin:0 auto}
    .hero-card-b{position:static !important;width:70% !important;max-width:230px;margin:-16px 6px 0 auto}
    .hero-nota{position:static !important;display:block;transform:none !important;text-align:right;margin:18px 6px 0 0}
  }

  /* --- até 700px: tira os traços de ligação entre as rotas, que sobravam
         soltos no início da linha quando a lista quebrava --- */
  @media (max-width:700px){
    .rota-traco{display:none !important}
  }

  /* --- até 600px: celular --- */
  @media (max-width:600px){
    /* topo: marca em cima, risco, e a etiqueta embaixo (antes quebrava em duas linhas) */
    .topo{flex-wrap:wrap;gap:12px !important}
    .topo-risco{flex:1 0 100% !important;order:2}
    .topo-tag{order:3}

    /* linha de preços Premium / Clássico / Mini */
    .precos-mini{flex-wrap:wrap;gap:12px 20px !important}

    /* cabeçalho do painel de demonstração */
    .painel-head{flex-wrap:wrap;gap:4px !important;justify-content:flex-start !important}

    /* a barra de endereço não cabe com o sufixo */
    .url-sufixo{display:none !important}

    /* abas da vitrine ocupam a largura toda, uma por linha */
    .abas > button{flex:1 0 100% !important}

    /* iOS dá zoom em input com fonte < 16px */
    #dm-nome,#dm-valor{font-size:16px !important}

    /* rótulo do link da janela encurta */
    .aba-nova-longo{display:none}
    .aba-nova-curto{display:inline}
  }
</style>
</head>
<body>

<!-- HERO -->
<header style="background:#e9e6e1;padding:clamp(28px,4vw,44px) clamp(24px,7vw,110px) clamp(64px,9vw,120px);position:relative;overflow:hidden">
  <div class="topo" style="display:flex;align-items:center;gap:22px;margin-bottom:clamp(44px,7vw,80px)">
    <span style="font-family:'Cormorant Garamond',serif;font-size:clamp(17px,2vw,22px);letter-spacing:.22em;white-space:nowrap">{MARCA}</span>
    <span class="topo-risco" style="flex:1;height:1px;background:#c9c3ba"></span>
    <span class="topo-tag" style="font-size:11px;letter-spacing:.24em;text-transform:uppercase;color:#8a6f4a;white-space:nowrap">sites para fotógrafos</span>
  </div>
  <div class="hero-grid" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(300px,100%),1fr));gap:clamp(36px,6vw,80px);align-items:center">
    <div>
      <p style="font-size:12px;letter-spacing:.28em;text-transform:uppercase;color:#8a6f4a;margin:0 0 20px">para quem manda proposta por PDF</p>
      <h1 style="font-family:'Cormorant Garamond',serif;font-weight:300;font-size:clamp(36px,4.6vw,64px);line-height:1.14;margin:0;max-width:17ch;text-wrap:balance">O seu trabalho merece mais que um <em style="font-style:italic;color:#8a6f4a">PDF</em> com propaganda de outra empresa.</h1>
      <p style="font-size:clamp(15.5px,1.5vw,18px);line-height:1.85;color:#3b3630;max-width:48ch;margin:26px 0 0;text-wrap:pretty">A sua proposta pode ser uma página limpa, com link próprio, com a sua cara. E você edita sozinha, quando quiser.</p>
      <div style="display:flex;align-items:center;gap:26px;flex-wrap:wrap;margin-top:36px">
        <a href={waLink} style="display:inline-block;font-size:12.5px;letter-spacing:.22em;text-transform:uppercase;color:#14110f;border-bottom:1px solid #8a6f4a;padding-bottom:7px">Quero ver como fica a minha</a>
        <span style="font-size:12px;color:#6d675f;letter-spacing:.06em">leva 2 minutos, é só rolar</span>
      </div>
    </div>
    <div class="hero-colagem" style="position:relative;min-height:clamp(340px,40vw,480px)">
      <div class="hero-card-a" style="position:absolute;top:0;left:2%;width:58%;background:#fff;box-shadow:0 30px 70px rgba(20,17,15,.28)">
        <div style="display:flex;align-items:center;gap:8px;padding:8px 11px;border-bottom:1px solid rgba(0,0,0,.08)">
          <span style="display:flex;gap:4px"><i style="width:6px;height:6px;border-radius:50%;background:#c9c3ba;display:block"></i><i style="width:6px;height:6px;border-radius:50%;background:#c9c3ba;display:block"></i><i style="width:6px;height:6px;border-radius:50%;background:#c9c3ba;display:block"></i></span>
          <span style="font-size:9px;letter-spacing:.04em;color:#3b3630">seuestudio.com.br/<b style="font-weight:500;color:#8a6f4a">ensaios</b></span>
        </div>
        <Image src={heroGestante} alt="" width={760} widths={[380, 760]} sizes="(max-width:860px) 360px, 30vw" loading="eager" fetchpriority="high" style="width:100%;height:clamp(200px,24vw,290px);object-fit:cover" />
        <div style="padding:16px 18px 18px">
          <p style="font-size:8.5px;letter-spacing:.28em;text-transform:uppercase;color:#8a6f4a;margin:0 0 5px">ensaio externo</p>
          <p style="font-family:'Cormorant Garamond',serif;font-size:clamp(19px,2vw,24px);letter-spacing:.06em;margin:0 0 11px;color:#14110f">Luz de fim de tarde</p>
          <ul style="list-style:none;margin:0 0 12px;padding:0;display:flex;flex-direction:column;gap:6px">
            <li style="font-size:10.5px;color:#3b3630;display:flex;gap:8px;align-items:flex-start;line-height:1.4"><span style="width:4px;height:4px;border-radius:50%;background:#8a6f4a;margin-top:6px;flex:none"></span>Até 1h e 30 de sessão</li>
            <li style="font-size:10.5px;color:#3b3630;display:flex;gap:8px;align-items:flex-start;line-height:1.4"><span style="width:4px;height:4px;border-radius:50%;background:#8a6f4a;margin-top:6px;flex:none"></span>40 fotos digitais em alta</li>
            <li style="font-size:10.5px;color:#3b3630;display:flex;gap:8px;align-items:flex-start;line-height:1.4"><span style="width:4px;height:4px;border-radius:50%;background:#8a6f4a;margin-top:6px;flex:none"></span>2 trocas de look</li>
          </ul>
          <div style="display:flex;align-items:baseline;justify-content:space-between;gap:12px;border-top:1px solid #e3ded6;padding-top:11px">
            <span style="font-size:9px;letter-spacing:.2em;text-transform:uppercase;color:#6d675f">pacote premium</span>
            <span style="font-family:'Cormorant Garamond',serif;font-size:20px;font-weight:500;color:#14110f">R$ 980</span>
          </div>
        </div>
      </div>
      <div class="hero-card-b" style="position:absolute;bottom:0;right:0;width:42%;background:#fff;padding:8px 8px 12px;box-shadow:0 30px 70px rgba(20,17,15,.3);transform:rotate(2.5deg)">
        <Image src={heroNewborn} alt="" width={520} widths={[260, 520]} sizes="(max-width:860px) 230px, 22vw" loading="eager" style="width:100%;height:clamp(150px,18vw,210px);object-fit:cover" />
        <div style="padding:11px 6px 4px;text-align:center">
          <p style="font-family:'Cormorant Garamond',serif;font-style:italic;font-size:clamp(15px,1.5vw,18px);color:#14110f;margin:0 0 6px">ensaio no campo</p>
          <span style="font-size:8px;letter-spacing:.14em;text-transform:uppercase;color:#6d675f;display:block;line-height:1.5">45 min · 20 fotos · 1 look</span>
          <span style="font-size:8px;letter-spacing:.2em;text-transform:uppercase;color:#8a6f4a;display:block;margin-top:4px">a partir de R$ 820</span>
        </div>
      </div>
      <span class="hero-nota" style="position:absolute;top:-2%;right:1%;font-family:'Cormorant Garamond',serif;font-style:italic;font-size:clamp(17px,1.7vw,22px);color:#8a6f4a;transform:rotate(-3deg)">a sua cara, do início ao fim</span>
    </div>
  </div>
</header>

<!-- 01 ANTES E DEPOIS -->
<section style="padding:clamp(70px,10vw,130px) clamp(24px,6vw,110px);max-width:1240px;margin:0 auto">
  <p style="font-size:12px;letter-spacing:.28em;text-transform:uppercase;color:#8a6f4a;margin:0 0 18px">01 · antes e depois</p>
  <h2 style="font-family:'Cormorant Garamond',serif;font-weight:300;font-style:italic;font-size:clamp(30px,3.6vw,50px);margin:0 0 14px;line-height:1.2">A mesma proposta. Dois jeitos de chegar.</h2>
  <p style="font-size:16px;line-height:1.8;color:#3b3630;max-width:60ch;margin:0 0 46px;text-wrap:pretty">O conteúdo é o mesmo: seus pacotes, suas fotos, seus valores. O que muda é o que a sua cliente vê primeiro.</p>
  <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(290px,100%),1fr));gap:clamp(20px,3vw,40px);align-items:stretch">
    <div>
      <p style="font-size:11px;letter-spacing:.24em;text-transform:uppercase;color:#6d675f;margin:0 0 12px">hoje</p>
      <div style="background:#f4f2ee;border:1px solid #c9c3ba;box-shadow:0 14px 40px rgba(20,17,15,.1);overflow:hidden">
        <div style="background:#3a3a3a;color:#fff;display:flex;align-items:center;gap:10px;padding:10px 14px;font-size:11px;letter-spacing:.08em"><span style="background:#d64545;color:#fff;font-size:9px;letter-spacing:.1em;padding:3px 7px">PDF</span> proposta_pacotes_2026_final_v3.pdf · 18 MB</div>
        <div style="background:linear-gradient(90deg,#7b4fd6,#e05fa0);color:#fff;text-align:center;font-size:11px;letter-spacing:.1em;padding:8px 12px">✦ Anúncio · Crie você também seu catálogo grátis na PlataformaX</div>
        <div style="padding:26px 26px 8px;position:relative">
          <div style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;pointer-events:none"><span style="font-size:26px;letter-spacing:.3em;color:rgba(20,17,15,.08);transform:rotate(-18deg);white-space:nowrap">PLATAFORMAX · GRÁTIS</span></div>
          <p style="font-family:'Cormorant Garamond',serif;font-size:22px;letter-spacing:.12em;text-transform:uppercase;margin:0 0 4px;color:#3b3630">Primeiro ano</p>
          <p style="font-size:10px;letter-spacing:.24em;text-transform:uppercase;color:#8a8378;margin:0 0 18px">pacotes 2026</p>
          <div style="display:flex;gap:8px;margin-bottom:18px">
            <div style="flex:1;height:64px;background:#dcd6cc"></div>
            <div style="flex:1;height:64px;background:#d2cabe"></div>
            <div style="flex:1;height:64px;background:#e0dad0"></div>
          </div>
          <div style="height:8px;background:#e3ded6;margin-bottom:8px"></div>
          <div style="height:8px;background:#e3ded6;width:76%;margin-bottom:8px"></div>
          <div style="height:8px;background:#e3ded6;width:58%"></div>
        </div>
        <div style="background:#efece6;border-top:1px solid #ddd7cc;text-align:center;font-size:10px;letter-spacing:.12em;color:#9a927f;padding:9px 12px;margin-top:22px">feito com PlataformaX · remova este selo assinando o plano Pro</div>
      </div>
      <ul style="list-style:none;padding:0;margin:18px 0 0;font-size:14px;line-height:2;color:#6d675f">
        <li>arquivo pesado no WhatsApp da cliente</li>
        <li>propaganda de terceiro na frente dela</li>
        <li>mudou um preço, refaz e reenvia tudo</li>
      </ul>
    </div>
    <div>
      <p style="font-size:11px;letter-spacing:.24em;text-transform:uppercase;color:#8a6f4a;margin:0 0 12px">com página própria</p>
      <div style="background:#fff;border:1px solid rgba(0,0,0,.1);box-shadow:0 14px 40px rgba(20,17,15,.1);overflow:hidden">
        <div style="background:#e9e6e1;display:flex;align-items:center;gap:10px;padding:10px 14px;border-bottom:1px solid rgba(0,0,0,.08)">
          <span style="display:flex;gap:5px"><i style="width:8px;height:8px;border-radius:50%;background:#c9c3ba;display:block"></i><i style="width:8px;height:8px;border-radius:50%;background:#c9c3ba;display:block"></i><i style="width:8px;height:8px;border-radius:50%;background:#c9c3ba;display:block"></i></span>
          <span style="flex:1;background:#fff;border:1px solid rgba(0,0,0,.08);font-size:11px;letter-spacing:.06em;color:#3b3630;padding:5px 12px">seuestudio.com.br/<b style="font-weight:500;color:#8a6f4a">primeiro-ano</b></span>
        </div>
        <div style="padding:30px 26px 26px;background:#e9e6e1">
          <p style="font-family:'Cormorant Garamond',serif;font-size:24px;letter-spacing:.14em;text-transform:uppercase;margin:0 0 4px;text-align:center">Primeiro ano</p>
          <p style="font-size:10px;letter-spacing:.28em;text-transform:uppercase;color:#8a6f4a;margin:0 0 20px;text-align:center">pacotes 2026</p>
          <div style="display:flex;gap:8px;margin-bottom:20px">
            <img src="/assets/ph-p-01.svg" alt="" style="flex:1;min-width:0;height:76px;object-fit:cover" />
            <img src="/assets/ph-p-02.svg" alt="" style="flex:1;min-width:0;height:76px;object-fit:cover" />
            <img src="/assets/ph-p-03.svg" alt="" style="flex:1;min-width:0;height:76px;object-fit:cover" />
          </div>
          <div class="precos-mini" style="display:flex;gap:14px;justify-content:center;text-align:center;font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:#3b3630">
            <span>Premium<br /><b style="font-family:'Cormorant Garamond',serif;font-size:17px;font-weight:500;letter-spacing:.04em">R$ 980</b></span>
            <span>Clássico<br /><b style="font-family:'Cormorant Garamond',serif;font-size:17px;font-weight:500;letter-spacing:.04em">R$ 820</b></span>
            <span>Mini<br /><b style="font-family:'Cormorant Garamond',serif;font-size:17px;font-weight:500;letter-spacing:.04em">R$ 680</b></span>
          </div>
          <div style="text-align:center;margin-top:20px"><span style="display:inline-block;background:#14110f;color:#fff;font-size:10px;letter-spacing:.2em;text-transform:uppercase;padding:9px 18px">Reservar pelo WhatsApp</span></div>
        </div>
      </div>
      <ul style="list-style:none;padding:0;margin:18px 0 0;font-size:14px;line-height:2;color:#3b3630">
        <li>um link leve, próprio, por tipo de ensaio</li>
        <li>só a sua marca, do início ao fim</li>
        <li>mudou o preço, o link já está atualizado</li>
      </ul>
    </div>
  </div>
</section>

<!-- 02 DEMO INTERATIVA -->
<section style="background:#fff;border-top:1px solid #c9c3ba;border-bottom:1px solid #c9c3ba">
  <div style="max-width:1240px;margin:0 auto;padding:clamp(70px,10vw,130px) clamp(24px,6vw,110px)">
    <p style="font-size:12px;letter-spacing:.28em;text-transform:uppercase;color:#8a6f4a;margin:0 0 18px">02 · experimente agora</p>
    <h2 style="font-family:'Cormorant Garamond',serif;font-weight:300;font-style:italic;font-size:clamp(30px,3.6vw,50px);margin:0 0 14px;line-height:1.2">Parece simples? É simples mesmo.</h2>
