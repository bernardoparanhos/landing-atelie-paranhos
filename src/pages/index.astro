<!-- CTA FINAL -->
<section style="background:#efe9df;padding:clamp(72px,10vw,140px) clamp(24px,7vw,110px);text-align:center">
  <p style="font-size:12px;letter-spacing:.28em;text-transform:uppercase;color:#8a6f4a;margin:0 0 22px">a próxima proposta pode sair diferente</p>
  <h2 style="font-family:'Cormorant Garamond',serif;font-weight:300;font-size:clamp(32px,4.4vw,60px);margin:0 auto;line-height:1.15;max-width:18ch;text-wrap:balance;color:#14110f">Me chama e me conta como você envia as suas hoje.</h2>
  <a class="btn-wa" href={waLink} style="display:inline-block;margin-top:40px;background:#14110f;color:#fff;font-size:13px;letter-spacing:.22em;text-transform:uppercase;padding:18px 38px;min-height:44px;box-sizing:border-box">Chamar no WhatsApp</a>
  <p style="font-size:14px;color:#6d675f;margin:22px 0 0">Sem formulário, sem compromisso. É só uma conversa.</p>
