---
import { clients, templateLiveUrl } from "@/config/site";
import { translations, type Lang } from "@/config/i18n";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = translations[lang];
const tp = t.template;

// Os nomes vêm do config para a frase não mentir se um cliente sair da lista.
const nomes = clients.map((c) => c.name);
const amarra =
  nomes.length >= 2
    ? tp.amarra.replace("%a", nomes[0]).replace("%b", nomes[1])
    : tp.amarraSozinha;

const abas = tp.abas;
const inicial = abas[0];
---
<section id="template" style="max-width:1180px;margin:0 auto;padding:clamp(60px,8vw,106px) clamp(22px,6vw,100px)">
  <p style="font-size:13px;font-weight:500;color:var(--gold);margin:0 0 16px"><span style="opacity:.55;margin-right:10px">{tp.numero}</span>{tp.kicker}</p>

  <div style="display:flex;flex-direction:column;gap:clamp(28px,4vw,44px)">
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(290px,100%),1fr));gap:clamp(22px,4vw,56px);align-items:start">
      <h2 style="font-weight:300;font-size:clamp(28px,3.6vw,44px);line-height:1.12;letter-spacing:-.03em;margin:0;max-width:18ch">{tp.titulo}</h2>

      <div>
        {/* A seção 01 já provou isto com dois sites reais. Em vez de afirmar
            de novo no vazio, a frase aponta para a prova que a pessoa
            acabou de rolar. */}
        <p style="font-size:16px;line-height:1.75;color:var(--ink-soft);margin:0 0 18px;text-wrap:pretty"><strong style="font-weight:500;color:var(--ink)">{amarra}</strong> {tp.corpo1}</p>
        <p style="font-size:16px;line-height:1.75;color:var(--ink-soft);margin:0 0 22px;text-wrap:pretty">{tp.corpo2}</p>
        <a href={templateLiveUrl} target="_blank" rel="noopener" style="display:inline-block;font-size:15px;font-weight:500;color:var(--ink);border-bottom:1px solid var(--gold);padding-bottom:5px;min-height:44px">{tp.navegar}</a>
      </div>
    </div>

    <div>
      {/* Abas de verdade (role=tablist): além do clique, ← e → trocam de
          aba, que é o que um leitor de tela e um teclado esperam de algo
          desenhado como aba. */}
      <div role="tablist" aria-label={tp.tablistLabel} style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:14px">
        {abas.map((aba, i) => (
          <button
            type="button"
            role="tab"
            id={`aba-${aba.id}`}
            class="aba"
            data-src={aba.src}
            data-url={aba.url}
            aria-controls="janela-frame"
            aria-selected={i === 0 ? "true" : "false"}
            tabindex={i === 0 ? 0 : -1}
            style="font-family:inherit;font-size:14.5px;font-weight:500;padding:11px 20px;border-radius:2px;cursor:pointer;min-height:44px"
          >{aba.rotulo}</button>
        ))}
      </div>

      <div style="background:#fff;border:1px solid var(--line);border-radius:3px;overflow:hidden;box-shadow:0 18px 44px rgba(46,37,33,.08)">
        <div style="display:flex;align-items:center;gap:10px;padding:10px 14px;border-bottom:1px solid #f0e3da">
          <span style="display:flex;gap:6px" aria-hidden="true"><i style="width:8px;height:8px;border-radius:50%;background:#e9dcd2;display:block"></i><i style="width:8px;height:8px;border-radius:50%;background:#e9dcd2;display:block"></i><i style="width:8px;height:8px;border-radius:50%;background:#e9dcd2;display:block"></i></span>
          <span id="janela-url" style="flex:1;font-size:12.5px;color:var(--muted);overflow:hidden;text-overflow:ellipsis;white-space:nowrap">{inicial.url}</span>
        </div>

        {/* A janela carrega o template de verdade, do próprio domínio.
            Precisa ser local por duas razões: a CSP tem frame-src 'self',
            e é este render que parece um site pronto — um placeholder numa
            seção que afirma "pronto e testado" diz o contrário do texto. */}
        <iframe
          id="janela-frame"
          class="janela-frame"
          src={inicial.src}
          title={tp.frameTitulo}
          loading="lazy"
          sandbox="allow-scripts allow-same-origin"
          referrerpolicy="no-referrer"
          style="display:block;width:100%;height:clamp(440px,70vh,680px);border:0;background:var(--bg)"
        ></iframe>
      </div>

      <div style="display:flex;flex-wrap:wrap;gap:8px;margin-top:16px;align-items:center">
        {tp.pages.map((pg) => (
          <span style={"font-size:13px;border-radius:40px;padding:6px 13px;" + (pg === tp.highlight ? "color:#fff;background:var(--gold);border:1px solid var(--gold)" : "color:var(--ink-soft);background:#fff;border:1px solid var(--line)")}>{pg}</span>
        ))}
      </div>
      <p style="font-size:13.5px;color:var(--muted);margin:12px 0 0">{tp.nota}</p>
    </div>
  </div>
</section>

<style>
  /* A janela já tem a moldura do navegador desenhada em volta: uma barra
     de rolagem do iframe por cima dela estraga a ilusão de site pronto. */
  .janela-frame { scrollbar-width: none; -ms-overflow-style: none; }
  .janela-frame::-webkit-scrollbar { width: 0; height: 0; display: none; }

  .aba {
    background: #fff;
    color: var(--ink-soft);
    border: 1px solid var(--line);
    transition: background .25s, color .25s, border-color .25s;
  }
  .aba:hover { border-color: var(--gold); color: var(--ink); }
  .aba[aria-selected="true"] {
    background: var(--ink);
    color: #fff;
    border-color: var(--ink);
  }
</style>

<script>
  // Empacotado pelo Astro num arquivo próprio (nada de script inline), para
  // a página rodar sob Content-Security-Policy com script-src 'self'.
  //
  // Serve as duas versões sem mudança: o endereço e o rótulo de cada aba
  // vêm do HTML, em data-src e data-url, postos pelo dicionário.

  const tablist = document.querySelector<HTMLElement>('[role="tablist"]');
  const frame = document.getElementById("janela-frame") as HTMLIFrameElement | null;
  const urlEl = document.getElementById("janela-url");

  if (tablist && frame && urlEl) {
    const abas = Array.from(tablist.querySelectorAll<HTMLButtonElement>('[role="tab"]'));

    function selecionar(alvo: HTMLButtonElement, focar: boolean) {
      const src = alvo.getAttribute("data-src");
      const url = alvo.getAttribute("data-url");
      if (!src || !frame || !urlEl) return;

      // Só troca o src se mudou: reatribuir o mesmo endereço recarregaria
      // o iframe e jogaria fora a rolagem de quem já estava navegando nele.
      if (frame.getAttribute("src") !== src) frame.setAttribute("src", src);
      urlEl.textContent = url;

      for (const a of abas) {
        const ativa = a === alvo;
        a.setAttribute("aria-selected", ativa ? "true" : "false");
        a.tabIndex = ativa ? 0 : -1;
      }
      if (focar) alvo.focus();
    }

    for (const aba of abas) {
      aba.addEventListener("click", () => selecionar(aba, false));
    }

    // ← e → andam entre as abas e dão a volta nas pontas, que é o
    // comportamento que o padrão de tablist define.
    tablist.addEventListener("keydown", (e: KeyboardEvent) => {
      if (e.key !== "ArrowRight" && e.key !== "ArrowLeft") return;
      const atual = abas.findIndex((a) => a.getAttribute("aria-selected") === "true");
      if (atual < 0) return;
      e.preventDefault();
      const passo = e.key === "ArrowRight" ? 1 : -1;
      selecionar(abas[(atual + passo + abas.length) % abas.length], true);
    });
  }
</script>
