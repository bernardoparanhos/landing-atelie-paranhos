---
import { wa } from "@/config/site";
import { translations, type Lang } from "@/config/i18n";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = translations[lang];
const c = t.cta;
---
<section style="padding:clamp(64px,9vw,112px) clamp(22px,6vw,100px);text-align:center">
  <p style="font-size:13px;font-weight:500;color:var(--gold);margin:0 0 18px">{c.kicker}</p>
  <h2 style="font-weight:300;font-size:clamp(30px,4.2vw,52px);line-height:1.1;letter-spacing:-.035em;margin:0 auto;max-width:19ch;text-wrap:balance">{c.titulo}</h2>
  <a class="btn-dark" href={wa(lang, t.waPadrao)} target="_blank" rel="noopener" style="display:inline-block;margin-top:32px;font-size:15px;font-weight:500;padding:16px 32px;border-radius:2px;min-height:44px">{c.botao}</a>
  <p style="font-size:14.5px;color:var(--muted);margin:18px 0 0">{c.nota}</p>
</section>
