---
import { wa, defaultWaMessage } from "@/config/site";
---
<section style="padding:clamp(64px,9vw,112px) clamp(22px,6vw,100px);text-align:center">
  <p style="font-size:13px;font-weight:500;color:var(--gold);margin:0 0 18px">A próxima página pode ser a sua</p>
  <h2 style="font-weight:300;font-size:clamp(30px,4.2vw,52px);line-height:1.1;letter-spacing:-.035em;margin:0 auto;max-width:19ch;text-wrap:balance">Me conta o que você precisa: página, propostas ou os dois.</h2>
  <a class="btn-dark" href={wa(defaultWaMessage)} target="_blank" rel="noopener" style="display:inline-block;margin-top:32px;font-size:15px;font-weight:500;padding:16px 32px;border-radius:2px;min-height:44px">Chamar no WhatsApp</a>
  <p style="font-size:14.5px;color:var(--muted);margin:18px 0 0">Sem formulário e sem compromisso. É só uma conversa.</p>
</section>
