---
import { Image } from "astro:assets";
import { clients } from "@/config/site";

const quotes = clients.filter((c) => c.quote);
---
<section id="exemplos" style="background:var(--ink);color:#fff">
  <div style="max-width:1180px;margin:0 auto;padding:clamp(60px,8vw,106px) clamp(22px,6vw,100px)">
    <p style="font-size:13px;font-weight:500;color:var(--gold-light);margin:0 0 16px"><span style="opacity:.6;margin-right:10px">01</span>Exemplos no ar</p>
    <h2 style="font-weight:300;font-size:clamp(28px,3.6vw,44px);line-height:1.12;letter-spacing:-.03em;margin:0 0 14px;max-width:20ch">Estes são os exemplos desta página.</h2>
    <p style="font-size:16px;line-height:1.7;color:rgba(255,255,255,.7);max-width:56ch;margin:0 0 38px;text-wrap:pretty">Sites de clientes, rodando de verdade. O site e as propostas são os mesmos que as clientes deles recebem no WhatsApp.</p>

    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:clamp(18px,2.6vw,28px)">
      {clients.map((c) => (
        <div style="background:var(--card-dark);border:1px solid rgba(255,255,255,.12);border-radius:3px;overflow:hidden;display:flex;flex-direction:column">
          {/* contain, nao cover: estes sao prints de pagina, nao fotos. Os
              originais tem proporcao ~2:1 e, espremidos num quadro 4/3 com
              cover, perdiam 36% da largura — o titulo do site da cliente saia
              decepado dos dois lados. Com contain nada e cortado, seja qual
              for o print que entrar aqui depois. A caixa fica 2/1, que e
              quase a proporcao dos prints, entao a tarja preta e minima e as
              duas colunas continuam alinhadas. */}
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:1px;background:rgba(255,255,255,.12)">
            <a href={c.siteUrl} target="_blank" rel="noopener" style="display:block;position:relative">
              <Image src={c.shotSite} alt={"Site de " + c.name} widths={[360, 480, 720, 960]} sizes="(max-width: 760px) 45vw, 240px" quality={92} style="width:100%;height:auto;aspect-ratio:2/1;object-fit:contain;background:var(--card-dark)" />
              <span style="position:absolute;left:0;bottom:0;background:rgba(46,37,33,.8);color:#fff;font-size:12px;padding:5px 10px">o site</span>
            </a>
            <a href={c.proposalsUrl} target="_blank" rel="noopener" style="display:block;position:relative">
              <Image src={c.shotProposals} alt={"Propostas de " + c.name} widths={[360, 480, 720, 960]} sizes="(max-width: 760px) 45vw, 240px" quality={92} style="width:100%;height:auto;aspect-ratio:2/1;object-fit:contain;background:var(--card-dark)" />
              <span style="position:absolute;left:0;bottom:0;background:rgba(46,37,33,.8);color:#fff;font-size:12px;padding:5px 10px">as propostas</span>
            </a>
          </div>

          <div style="padding:clamp(20px,2.6vw,28px);display:flex;flex-direction:column;flex:1">
            <p style="font-size:19px;font-weight:500;letter-spacing:-.02em;margin:0 0 4px">{c.name}</p>
            <p style="font-size:14px;color:rgba(255,255,255,.55);margin:0 0 20px">{c.niche}</p>

            <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(110px,1fr));gap:16px;padding:16px 0;border-top:1px solid rgba(255,255,255,.12);border-bottom:1px solid rgba(255,255,255,.12);margin-bottom:18px">
              {c.stats.map((s) => (
                <div>
                  <p style="font-size:12.5px;color:rgba(255,255,255,.5);margin:0 0 4px">{s.label}</p>
                  <p style="font-size:14.5px;margin:0">{s.value}</p>
                </div>
              ))}
            </div>

            {/* O rótulo nomeia a cliente de propósito: mais abaixo há um link
                para o template, e a pessoa precisa saber, antes de clicar,
                se vai abrir o site de alguém ou o modelo base. */}
            <div style="display:flex;flex-direction:column;gap:10px;margin-top:auto">
              <a class="row-link" href={c.siteUrl} target="_blank" rel="noopener" style="display:flex;align-items:center;justify-content:space-between;gap:12px;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.14);border-radius:2px;padding:13px 16px;font-size:14.5px;min-height:44px"><span>Ver o site {c.shortName}</span><span style="color:var(--gold-light)">↗</span></a>
              <a class="row-link" href={c.proposalsUrl} target="_blank" rel="noopener" style="display:flex;align-items:center;justify-content:space-between;gap:12px;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.14);border-radius:2px;padding:13px 16px;font-size:14.5px;min-height:44px"><span>Ver as propostas {c.shortName}</span><span style="color:var(--gold-light)">↗</span></a>
            </div>
          </div>
        </div>
      ))}
    </div>

    <div style="margin-top:clamp(40px,5vw,64px);display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:clamp(18px,2.6vw,28px)">
      {quotes.map((c) => (
        <figure style="margin:0;background:var(--card-dark);border:1px solid rgba(255,255,255,.12);border-radius:3px;padding:clamp(24px,3vw,34px);display:flex;flex-direction:column;gap:18px">
          <p style="font-size:clamp(17px,1.8vw,21px);font-weight:300;line-height:1.55;letter-spacing:-.01em;margin:0;color:#fff;text-wrap:pretty">{"“" + c.quote + "”"}</p>
          <figcaption style="display:flex;align-items:center;gap:12px;margin-top:auto">
            <span style="width:38px;height:38px;border-radius:50%;background:var(--gold);color:#fff;display:flex;align-items:center;justify-content:center;font-size:15px;font-weight:500;flex:none">{c.initial}</span>
            <span>
              <span style="display:block;font-size:14.5px;font-weight:500;color:#fff">{c.name}</span>
              <span style="display:block;font-size:13px;color:rgba(255,255,255,.55)">{c.niche}</span>
            </span>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
