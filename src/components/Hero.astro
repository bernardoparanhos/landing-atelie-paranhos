---
import { brand, wa } from "@/config/site";
import { translations, idiomas, type Lang } from "@/config/i18n";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = translations[lang];
const { eyebrow, stats, promessa } = t.hero;
---
<header style="padding:clamp(22px,3vw,34px) clamp(22px,6vw,100px) clamp(56px,8vw,104px);max-width:1180px;margin:0 auto">
  {/* A marca so existia no favicon, onde quase ninguem olha. Trazida para o
      topo, ela faz o cabecalho deixar de ser duas linhas de texto solto: o
      simbolo em ouro e a assinatura, a etiqueta a direita reaproveita a
      pilula que a secao 03 ja usa, e o fio fecha a faixa. */}
  <div class="topo" style="display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap;padding-bottom:18px;border-bottom:1px solid var(--line);margin-bottom:clamp(44px,7vw,84px)">
    <a class="marca-link" href={t.rota} style="display:flex;align-items:center;gap:11px" aria-label={brand}>
      <svg class="marca" width="30" height="30" viewBox="-1 34 112 112" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <g stroke="var(--ink)" stroke-width="4.5">
          <path d="M55 96 C50 82 44 70 34 62" />
          <path d="M55 96 C60 84 66 74 76 68" />
          <path d="M55 96 V70" />
          <path d="M55 70 C48 62 44 52 45 42 C56 48 58 60 55 70 Z" />
          <path d="M40 100 H70 L64 132 C63 137 60 140 55 140 C50 140 47 137 46 132 Z" />
          <path d="M37 100 H73" />
        </g>
        <g stroke="var(--gold)" stroke-width="4.5" fill="var(--gold)" fill-opacity="0.12">
          <path d="M34 62 C22 58 16 50 14 40 C27 41 35 50 40 62 Z" />
          <path d="M76 68 C88 62 94 54 96 44 C83 45 74 54 70 66 Z" />
        </g>
      </svg>
      <span style="font-size:16.5px;font-weight:500;letter-spacing:-.015em">{brand}</span>
    </a>

    <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap">
      <span style="display:inline-flex;align-items:center;gap:8px;font-size:12.5px;color:var(--ink-soft);background:#fff;border:1px solid var(--line);border-radius:40px;padding:6px 14px">
        <i aria-hidden="true" style="width:5px;height:5px;border-radius:50%;background:var(--gold);flex:none"></i>{t.meta.tagline}
      </span>

      {/* O seletor de versao. São dois links, nao dois botoes com
          JavaScript: cada versao e uma pagina de verdade, com endereco
          proprio, que o Google indexa e que se manda no WhatsApp para
          um lead de la. O aria-current marca a que ja esta aberta. */}
      <nav class="seletor" aria-label={t.meta.trocaIdioma}>
        {idiomas.map((l) => {
          const outra = translations[l];
          const atual = l === lang;
          return (
            <a
              class={"sigla" + (atual ? " atual" : "")}
              href={outra.rota}
              hreflang={outra.htmlLang}
              lang={outra.htmlLang}
              aria-current={atual ? "true" : undefined}
              aria-label={outra.idioma}
            >{outra.sigla}</a>
          );
        })}
      </nav>
    </div>
  </div>

  {/* Duas colunas: a promessa à esquerda, a objeção respondida à direita.
      O min(330px,100%) e a parte que importa: sem o min(), a coluna nunca
      encolhe abaixo de 330px e a pagina passa a rolar na horizontal em
      tela de 280px. Com ele, as duas empilham antes de ficarem estreitas
      demais para o titulo, em vez de espremerem a tipografia. */}
  <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(330px,100%),1fr));gap:clamp(34px,5vw,64px);align-items:center">

    <div>
      <p style="font-size:13px;font-weight:500;color:var(--gold);margin:0 0 20px;letter-spacing:.02em">{eyebrow}</p>

      <h1 style="font-weight:300;font-size:clamp(34px,4.6vw,56px);line-height:1.08;letter-spacing:-.035em;margin:0;max-width:15ch;text-wrap:balance">{t.hero.tituloInicio}<em style="font-style:italic;color:var(--gold)">{t.hero.tituloEnfase}</em>{t.hero.tituloFim}</h1>

      <p style="font-size:clamp(16px,1.5vw,18px);line-height:1.7;color:var(--ink-soft);max-width:46ch;margin:24px 0 0;text-wrap:pretty">{t.hero.sub}</p>

      <div style="display:flex;align-items:center;gap:20px;flex-wrap:wrap;margin-top:32px">
        <a class="btn-dark" href={wa(lang, t.waPadrao)} target="_blank" rel="noopener" style="display:inline-block;font-size:15px;font-weight:500;padding:15px 28px;border-radius:2px;min-height:44px">{t.hero.ctaWhatsapp}</a>

      </div>
    </div>

    {/* O cartão da promessa. O branco translúcido sobre o papel creme dá o
        leve descolamento do fundo sem virar uma caixa branca dura, e a
        sombra larga e fraca é a mesma linguagem das janelas das seções
        02 e 03 — é o que faz a página parecer feita, não montada. */}
    <aside style="background:rgba(255,255,255,.62);border:1px solid var(--line);border-radius:4px;padding:clamp(26px,3.2vw,38px);box-shadow:0 20px 48px rgba(46,37,33,.07)">
      <p style="font-size:clamp(19px,2vw,24px);font-weight:300;letter-spacing:-.025em;line-height:1.3;margin:0;text-wrap:balance">{promessa.tituloInicio} <em style="font-style:italic;color:var(--gold)">{promessa.tituloEnfase}</em> {promessa.tituloFim}</p>

      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(135px,1fr));gap:clamp(18px,2.4vw,30px);margin-top:clamp(22px,2.6vw,30px);padding-top:clamp(20px,2.4vw,26px);border-top:1px solid var(--line)">
        {/* O risco é o argumento: mostra o caminho de todo mundo sendo
            descartado, em vez de só afirmar que o nosso é melhor.
            text-decoration-color mais clara que o texto para o risco
            não competir com a leitura. */}
        <div>
          <p style="font-size:11px;font-weight:500;text-transform:uppercase;letter-spacing:.14em;margin:0 0 10px;color:var(--muted)">{promessa.colunaRuimRotulo}</p>
          <p style="font-size:14.5px;line-height:1.55;margin:0;color:var(--muted);text-decoration:line-through;text-decoration-color:rgba(138,125,116,.55);text-decoration-thickness:1px">{promessa.colunaRuimTexto}</p>
        </div>
        <div>
          <p style="font-size:11px;font-weight:500;text-transform:uppercase;letter-spacing:.14em;margin:0 0 10px;color:var(--gold)">{promessa.colunaBoaRotulo}</p>
          <p style="font-size:14.5px;line-height:1.55;margin:0;color:var(--ink-soft)">{promessa.colunaBoaTexto} <strong style="font-weight:500;color:var(--ink)">{promessa.colunaBoaEnfase}</strong></p>
        </div>
      </div>

      {/* Ancora pura, sem JavaScript: o scroll-behavior:smooth do html em
          Base.astro ja da a rolagem suave, e o bloco de
          prefers-reduced-motion a desliga para quem pediu.

          Mora aqui dentro de proposito: o cartao afirma que voce ve a
          pagina antes de pagar, e este botao e o caminho para conferir a
          afirmacao. Fora do cartao era so mais um botao; dentro, e a
          continuacao da frase. */}
      <a class="btn-gold" href="#como-funciona" style="display:flex;align-items:center;justify-content:center;gap:10px;margin-top:clamp(20px,2.4vw,26px);font-size:15px;font-weight:500;padding:15px 24px;border-radius:2px;min-height:44px">{t.hero.ctaComoFunciona} <svg class="seta" aria-hidden="true" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 4.5v15" /><path d="M18.5 13 12 19.5 5.5 13" /></svg></a>
    </aside>
  </div>

  <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:clamp(18px,3vw,40px);margin-top:clamp(52px,7vw,84px);border-top:1px solid var(--line);padding-top:26px">
    {stats.map((s) => (
      <div>
        <p style="font-size:clamp(26px,3vw,34px);font-weight:300;letter-spacing:-.03em;margin:0 0 4px">{s.value}</p>
        <p style="font-size:14px;color:var(--muted);margin:0;line-height:1.5">{s.label}</p>
      </div>
    ))}
  </div>
</header>

<style>
  /* O simbolo acompanha o nome no hover: a folha dourada preenche um fio
     mais e o conjunto sobe 1px. Desligado por prefers-reduced-motion na
     regra global do layout. */
  .topo .marca-link { transition: transform .25s; }
  .topo .marca-link:hover { color: inherit; transform: translateY(-1px); }
  .topo .marca g { transition: fill-opacity .25s; }
  .topo .marca-link:hover .marca g:last-child { fill-opacity: .26; }

  /* O seletor de versao: duas siglas numa moldura so, do tamanho da
     pilula ao lado. A ativa fica cheia; a outra e so um alvo de 44px
     com o texto apagado, para nao disputar atencao com o h1. */
  .seletor {
    display: inline-flex;
    border: 1px solid var(--line);
    border-radius: 40px;
    background: #fff;
    overflow: hidden;
  }
  .seletor .sigla {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 34px;
    padding: 6px 12px;
    font-size: 12.5px;
    font-weight: 500;
    letter-spacing: .04em;
    color: var(--muted);
    transition: background .25s, color .25s;
  }
  .seletor .sigla:hover { color: var(--ink); background: var(--bg); }
  .seletor .sigla.atual {
    background: var(--ink);
    color: #fff;
  }
  .seletor .sigla.atual:hover { background: var(--ink); color: #fff; }
</style>
