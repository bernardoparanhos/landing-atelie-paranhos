---
import { brand, tagline, wa, defaultWaMessage } from "@/config/site";

const stats = [
  { value: "até 3 dias", label: "para a primeira página no ar" },
  { value: "pagamento único", label: "sem mensalidade, sem taxa escondida" },
  { value: "no seu nome", label: "domínio registrado no seu CPF" },
];
---
<header style="padding:clamp(22px,3vw,34px) clamp(22px,6vw,100px) clamp(56px,8vw,104px);max-width:1180px;margin:0 auto">
  <div style="display:flex;align-items:center;justify-content:space-between;gap:20px;margin-bottom:clamp(52px,8vw,96px);flex-wrap:wrap">
    <span style="font-size:15px;font-weight:500;letter-spacing:-.01em">{brand}</span>
    <span style="font-size:13px;color:var(--muted)">{tagline}</span>
  </div>

  <p style="font-size:13px;font-weight:500;color:var(--gold);margin:0 0 20px;letter-spacing:.02em">Seu trabalho em um link só</p>

  <h1 style="font-weight:300;font-size:clamp(34px,5.2vw,62px);line-height:1.08;letter-spacing:-.035em;margin:0;max-width:17ch;text-wrap:balance">Página própria e propostas com <em style="font-style:italic;color:var(--gold)">link no seu nome</em>.</h1>

  <p style="font-size:clamp(16px,1.6vw,19px);line-height:1.7;color:var(--ink-soft);max-width:52ch;margin:24px 0 0;text-wrap:pretty">Nada de PDF pesado nem plataforma de terceiro com propaganda em cima do seu trabalho. Pagamento único, domínio no seu nome e uma página que só tem a sua cara.</p>

  <div style="display:flex;align-items:center;gap:20px;flex-wrap:wrap;margin-top:32px">
    <a class="btn-dark" href={wa(defaultWaMessage)} target="_blank" rel="noopener" style="display:inline-block;font-size:15px;font-weight:500;padding:15px 28px;border-radius:2px;min-height:44px">Falar no WhatsApp</a>
  </div>

  <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:clamp(18px,3vw,40px);margin-top:clamp(52px,7vw,84px);border-top:1px solid var(--line);padding-top:26px">
    {stats.map((s) => (
      <div>
        <p style="font-size:clamp(26px,3vw,34px);font-weight:300;letter-spacing:-.03em;margin:0 0 4px">{s.value}</p>
        <p style="font-size:14px;color:var(--muted);margin:0;line-height:1.5">{s.label}</p>
      </div>
    ))}
  </div>
</header>
