# Cabeçalhos de segurança e cache — formato Netlify / Cloudflare Pages.
# Na Vercel quem vale é o vercel.json (mesmo conteúdo). Ver docs/SEGURANCA.md.
#
# Este arquivo é copiado para dist/ no build e lido pela hospedagem.
# Se um dia trocar de hospedagem, confira em https://securityheaders.com
# se os cabeçalhos continuam chegando.

/*
  # Só HTTPS por 2 anos, incluindo subdomínios. Cuidado: uma vez enviado,
  # o navegador lembra. Só mantenha se todos os subdomínios tiverem HTTPS.
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  # Impede o navegador de "adivinhar" o tipo de um arquivo (evita que um
  # upload .txt seja interpretado como script).
  X-Content-Type-Options: nosniff
  # Ninguém pode embutir o site num iframe fora do próprio domínio
  # (clickjacking). O 'self' é necessário: as seções 02 e 03 embutem /demos/
  # aqui mesmo.
  X-Frame-Options: SAMEORIGIN
  # Não vaza o caminho completo da página de origem para outros domínios.
  Referrer-Policy: strict-origin-when-cross-origin
  # Desliga APIs que este site nunca usa. Se um script de terceiro entrar
  # aqui um dia (pixel, chat), ele já nasce sem acesso a nada disso.
  Permissions-Policy: accelerometer=(), autoplay=(), camera=(), display-capture=(), encrypted-media=(), fullscreen=(self), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), publickey-credentials-get=(), screen-wake-lock=(), usb=(), xr-spatial-tracking=()
  # Isolamento entre janelas/abas abertas a partir daqui.
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  # Content-Security-Policy: a lista completa do que a página pode carregar.
  # 'unsafe-inline' aparece só em style-src porque a landing usa style="" em
  # cada elemento (veio assim do gerador de design). Scripts NÃO têm inline:
  # tudo é arquivo externo do próprio domínio, então um XSS não consegue
  # executar código injetado. frame-ancestors 'self' permite as janelas das
  # seções 02 e 03 e bloqueia qualquer outro site de embutir esta página.
  Content-Security-Policy: default-src 'self'; base-uri 'none'; object-src 'none'; form-action 'none'; frame-ancestors 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-src 'self'; upgrade-insecure-requests

# Arquivos com hash no nome (gerados pelo Astro) nunca mudam de conteúdo:
# podem ficar em cache para sempre.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Fontes também são estáveis (o nome muda se você trocar o arquivo).
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# O HTML precisa ser revalidado, senão uma alteração de preço demora a aparecer.
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate
